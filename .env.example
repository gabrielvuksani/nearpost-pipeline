# Nearpost recorder: go-live credentials.
#
#   cp .env.example .env    # .env is gitignored; never commit it
#   chmod 600 .env
#   (fill in what you have, then)  ./scripts/go-live.sh
#
# Plain KEY=value lines: no quotes, no spaces around "=". Anything left blank, the
# wizard will ask for and show you exactly where to find it. It checks each value
# against the real service before using it.

# GitHub repository that runs the recorder (owner/name).
NEARPOST_GITHUB_REPO=gabrielvuksani/nearpost-pipeline

# The Odds API: free Starter plan key, emailed after signup at https://the-odds-api.com
ODDS_API_KEY=

# healthchecks.io: Project → Settings → "Ping key" (create one if none exists).
HEALTHCHECKS_PING_KEY=

# Cloudflare: Account ID (dashboard → R2 Object Storage → Account details).
R2_ACCOUNT_ID=
# R2 API token scoped to the nearpost-recorder bucket, "Object Read & Write".
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nearpost-recorder

# Fine-grained GitHub token for the Cloudflare Worker: this repo only, "Actions: read
# and write". The wizard stores it as a Worker secret. Delete this line once it's done.
WORKER_GITHUB_TOKEN=
# When that token expires (YYYY-MM-DD); put a reminder in your calendar too.
WORKER_GITHUB_TOKEN_EXPIRES=
